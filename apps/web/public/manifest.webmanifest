{
  "id": "/",
  "name": "Personal Cloud",
  "short_name": "PCS",
  "description": "Tu nube personal en tu propio disco.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/archivos",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0f1217",
  "theme_color": "#2457d6",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Archivos", "url": "/archivos", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Subidas", "url": "/transferencias", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Papelera", "url": "/papelera", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
