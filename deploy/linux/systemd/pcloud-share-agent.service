# /etc/systemd/system/pcloud-share-agent.service — agente root mínimo de la puerta de invitados
# (ADR-0018). Lo lanza pcloud-share-agent.path; procesa las peticiones pendientes y termina.
# Instalado por pcloud-install-share.sh. No editar a mano.
#
# Solo publica o retira con Tailscale Funnel (en el nodo dedicado <host>-compartir, ADR-0019) el
# socket de la puerta de invitados (ver el script). Habla con tailscaled por su socket local: no
# necesita red.

[Unit]
Description=Personal Cloud Storage: agente de la puerta de invitados (Tailscale Funnel)
After=tailscaled.service pcloud-share-tailscaled.service
# Sin límite de arranques: crear y retirar varios enlaces seguidos son varias peticiones.
# No puede entrar en bucle: el agente siempre vacía el buzón y termina con éxito.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/pcloud/current/deploy/linux/share/pcloud-share-agent.sh
TimeoutStartSec=90
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pcloud/share-agent /run
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
