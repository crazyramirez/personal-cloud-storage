# /etc/systemd/system/pcloud-backup-agent.service — agente root mínimo de la copia de seguridad
# (ADR-0017). Lo lanza pcloud-backup-agent.path; procesa las peticiones pendientes y termina.
# Instalado por pcloud-install-backup.sh. No editar a mano.
#
# Solo monta/desmonta el disco de copia en /srv/pcloud-backup (ver el script). DELIBERADAMENTE sin
# PrivateTmp, ProtectSystem, PrivateDevices ni ningún otro aislamiento que cree un espacio de
# montajes propio: el montaje tiene que hacerse en el del sistema para que pcloud.service lo vea.

[Unit]
Description=Personal Cloud Storage: agente de montaje del disco de copia
After=local-fs.target
# Sin límite de arranques: una sincronización hace varias peticiones seguidas (montar, desmontar,
# reintentos) y el límite por defecto (5 en 10 s) dejaría el .path en fallo y el disco montado.
# No puede entrar en bucle: el agente siempre vacía el buzón y termina con éxito.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/pcloud/current/deploy/linux/backup/pcloud-backup-agent.sh
TimeoutStartSec=180
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
